# Copy to .env (never commit .env). The key stays on the server — the browser never sees it.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. claude-sonnet-5-5 is roughly half the price.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional. low | medium | high. Medium suits daily coaching chat.
ANTHROPIC_EFFORT=medium
# Port for the API (and, with `npm start`, the built app).
PORT=8787
